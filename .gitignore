# Ignore environment files
.env

# generated files and folders
.files/
.chainlit/
**/*chainlit.md
.venv/
qdrant_storage/
vdb/
db/

# other files and folders
misc
tmp

# Embedded git repo (has its own .git); a build input for the legacy indexer-ui
# profile, not source tracked here. Ignoring it stops `git add .` from staging
# it as a broken gitlink.
extern/indexer-ui/

# Ignore __pycache__ directories
__pycache__/
**/__pycache__/

**/*upload_dir

# Ignore some local files
*.ipynb
**/*.ipynb


# Ignore Python bytecode files
*.pyc
*.pyo
*.csv

.venv/
model_weights/
model_weights/*
!model_weights/.gitkeep # Keep the placeholder

data/
data/*
!data/.gitkeep

ray_mount

**/*.env.compose
kotaemon
./temps_img
.python-version
.vscode
.DS_Store
logs/
old_logs/

data2/

*.db
test2/

volumes/
volumes/*
!volumes/.gitkeep # Keep the placeholder

# services
/services/
/services/*
!/services/.gitkeep # Keep the placeholder

*.csv
*.pkl

#helm
infra/charts/openrag-stack/charts/*.tgz

# Planning
.planning/

# Astro / Starlight
.astro/
dist/
node_modules/

# AI
.claude
.planning
docs/plans/

# Build artifacts
*.egg-info/

# Test / coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Local developer overrides (not committed)
docker-compose.override.yaml
docker-compose.override.yml

# Chainlit-generated locale files (only en-US and fr are curated/committed;
# other locales are auto-written at runtime).
i8n/*.json
!i8n/en-US.json
!i8n/fr.json

# Automatic evaluation pipeline (local data/artifacts, not committed)
openrag-versions/
tests/load/automatic-evaluation-pipeline/dataset.json
tests/load/automatic-evaluation-pipeline/dataset.manifest.json
tests/load/automatic-evaluation-pipeline/golden_uploads/
tests/load/automatic-evaluation-pipeline/pdf_files/
tests/load/automatic-evaluation-pipeline/reports/
