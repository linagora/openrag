# Minimal configuration for integration tests (health check only)
# LLM - not actually used for health check, but required by config
BASE_URL=http://localhost:8001/
API_KEY=sk-
MODEL=HuggingFaceTB/SmolLM2-135M-Instruct

# VLM - not actually used for health check
VLM_BASE_URL=http://localhost:8002/
VLM_API_KEY=sk-
VLM_MODEL=HuggingFaceTB/SmolVLM-Instruct

# Embedder - uses small, fast model
EMBEDDER_MODEL_NAME=ibm-granite/granite-embedding-small-english-r2
EMBEDDER_BASE_URL=http://vllm:8000/v1
MAX_MODEL_LEN=512

# Disable features not needed for health check
CONTEXTUAL_RETRIEVAL=false
RERANKER_ENABLED=false

# Prompts
PROMPTS_DIR=../prompts/example1

# Minimal resource config
MARKER_MAX_PROCESSES=1
MARKER_POOL_SIZE=1
RAY_POOL_SIZE=1
RAY_MAX_TASKS_PER_WORKER=1

# Ray settings
RAY_DEDUP_LOGS=0
RAY_ENABLE_RECORD_ACTOR_TASK_LOGGING=1
RAY_task_retry_delay_ms=3000
RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
RAY_memory_monitor_refresh_ms=0
