# Optional Docker Compose storage profile.
#
# The default compose stack keeps the historical host-path storage layout.
# Copy these values into your .env only when you intentionally want Docker
# named volumes for app data, model caches, PostgreSQL, and Milvus state.

DATA_VOLUME=appdata
LOG_VOLUME=logs
MODEL_WEIGHTS_VOLUME=modelweights
VLLM_CACHE=modelweights
DB_VOLUME=pgdata
MILVUS_COMPOSE=milvus/milvus.named-volumes.yaml
