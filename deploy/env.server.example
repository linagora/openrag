# =============================================================================
# OpenRAG - Server Deployment (GPU)
# =============================================================================
# Embeddings: vLLM (local GPU)
# LLM/VLM:    External or local endpoint
# Reranker:   Enabled (Infinity on GPU)
# =============================================================================

# LLM - For conversation
BASE_URL=
API_KEY=
MODEL=

# VLM - For image interpretation
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# EMBEDDER - vLLM (runs locally on GPU, no changes needed)
EMBEDDER_MODEL_NAME=jinaai/jina-embeddings-v3
# EMBEDDER_BASE_URL=http://vllm:8000/v1
# EMBEDDER_API_KEY=EMPTY
MAX_MODEL_LEN=8192

# RERANKER
RERANKER_ENABLED=true
RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base

# RAY
RAY_DEDUP_LOGS=0
RAY_ENABLE_RECORD_ACTOR_TASK_LOGGING=1
RAY_task_retry_delay_ms=3000
RAY_ENABLE_UV_RUN_RUNTIME_ENV=0
# RAY_memory_monitor_refresh_ms=0

# LOGGING
LOG_LEVEL=DEBUG
