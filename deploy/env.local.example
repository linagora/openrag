# =============================================================================
# OpenRAG - Local Laptop Deployment
# =============================================================================
# Embeddings: Ollama (in Docker)
# LLM/VLM:    External endpoint
# Reranker:   Disabled
# =============================================================================

# LLM - External endpoint for conversation
BASE_URL=https://your-llm-endpoint/v1/
API_KEY=your-api-key
MODEL=your-model-name

# VLM - External endpoint for image interpretation
VLM_BASE_URL=https://your-vlm-endpoint/v1/
VLM_API_KEY=your-api-key
VLM_MODEL=your-vlm-model-name

# EMBEDDER - Ollama in Docker (no changes needed)
EMBEDDER_BASE_URL=http://ollama:11434/v1
EMBEDDER_MODEL_NAME=qwen3-embedding:4b
EMBEDDER_API_KEY=ollama

# TUNING (optional - lower value = shorter answers)
# RERANKER_TOP_K=5
